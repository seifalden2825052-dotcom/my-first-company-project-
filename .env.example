# Runtime
NODE_ENV=production
PORT=8080
BASE_PATH=/
LOG_LEVEL=info

# PostgreSQL — use any reachable PostgreSQL provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Admin login — set strong values in the hosting provider's secret manager
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-secret

# Media storage
# A writable, persistent path on the Hostinger Node.js account.
# Prefer an absolute path outside the deployed release directory.
MEDIA_STORAGE_DIR=/home/USERNAME/tqp-media