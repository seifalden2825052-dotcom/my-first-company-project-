{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/top-quality-prospect run build",
  "outputDirectory": "artifacts/top-quality-prospect/dist/public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "artifacts/api-server/dist-serverless/**"
    },
    "api/[...path].mjs": {
      "includeFiles": "artifacts/api-server/dist-serverless/**"
    },
    "api/certificates/verify/[code].mjs": {
      "includeFiles": "artifacts/api-server/dist-serverless/**"
    },
    "api/certificates/qr/[code].mjs": {
      "includeFiles": "artifacts/api-server/dist-serverless/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
